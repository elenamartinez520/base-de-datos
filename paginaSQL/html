                    <th>Nombre</th>
                    <th>Alias</th>
                    <th>Descripción</th>
                    <th>Contenido</th>
                    <th>Tipo</th>
                    <th>Longitud</th>
                </tr>

                <tr>
                    <td>ID_Alumno</td>
                    <td>ID</td>
                    <td>PK de la tabla</td>
                    <td>2</td>
                    <td>INT</td>
                    <td>4</td>
                </tr>

